{
  "name": "face-score-kit",
  "version": "0.1.0",
  "description": "Fully client-side face analysis toolkit: rule-based aesthetic scoring, pixel-statistics skin signals, local-model age/gender estimation. No upload, no server, no tracking.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/analysis/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "onnxruntime-web": "1.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16"
  }
}
